# Copy to .env and fill in. .env is gitignored — never commit a real key.
OPENAI_API_KEY=sk-your-key-here

# Optional overrides
BOOKNOW_MODEL=gpt-4o-mini
BOOKNOW_TEMPERATURE=0.2
BOOKNOW_MAX_TOOL_ROUNDS=4
BOOKNOW_TIMEOUT=30
BOOKNOW_EMBEDDING_MODEL=text-embedding-3-small
# Where book embeddings are cached; leave empty to disable the cache.
BOOKNOW_EMBEDDING_CACHE=~/.cache/booknow/embeddings.json
